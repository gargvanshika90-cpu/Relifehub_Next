generator client {
  // provider = "prisma-client"
  // output   = "../generated/prisma"
   provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url = env("DATABASE_URL")
}


model User {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId

  firstName String
  lastName  String
  email     String   @unique
  password  String

  image     String?
  phone     String?
  address   String?
  city      String?
  state     String?
  pincode   String?

  // User can be both donor and requester
  donations        Donation[]
  donationRequests DonationRequest[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}


model Donation {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId

  itemName      String
  brand         String?
  category      String
  quantity      String
  condition     String
  price         Float?
  originalPrice Float?
  description   String?

  // Uploaded images
  images Json?

  // Category-specific information
  details Json?

  // Pickup details
  address String
  city    String
  state   String
  pincode String
  phone   String
  date    String?
  time    String?

  status String @default("Active")

  // Donor
  donorId String @db.ObjectId
  donor   User   @relation(fields: [donorId], references: [id])

  // Requests made by buyers/requesters
  requests DonationRequest[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}


model DonationRequest {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  // Donation being requested
  donationId String   @db.ObjectId
  donation   Donation @relation(fields: [donationId], references: [id])

  // User requesting the donation
  requesterId String @db.ObjectId
  requester   User   @relation(fields: [requesterId], references: [id])

  quantity String?
  message  String?

  status RequestStatus @default(PENDING)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}


enum RequestStatus {
  PENDING
  APPROVED
  REJECTED
  COMPLETED
  CANCELLED
}